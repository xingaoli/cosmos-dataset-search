# ==============================================
# Cosmos Video Dataset Search - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values
# Example: cp .env.example .env

# ==============================================
# Required API Keys
# ==============================================

# NVIDIA API Key (REQUIRED)
# Get your NGC key
NVIDIA_API_KEY=<your_api_key>

# ==============================================
# Data Directory
# ==============================================

# Path to your data directory (REQUIRED)
# This directory should contain your video/image files for indexing
DATA_DIR=/path/to/your/data

# Project root directory (auto-detected, but can override)
# PROJECT_ROOT=/path/to/cosmos-dataset-search

# ==============================================
# Tools Configuration
# ==============================================

# Source directory for video zip files (used by tools/1_extract_videos.py)
# TOOLS_ZIP_DIR=/path/to/your/video/zips

# Output directory for extracted videos (relative to PROJECT_ROOT or absolute path)
# TOOLS_EXTRACT_OUTPUT_DIR=./cds-data/phaiav_videos/h265

# S3 bucket and prefix for videos
S3_BUCKET=cosmos-test-bucket
# S3_PREFIX=phaiav/h264

# Pipeline and collection (set COLLECTION_ID after running tools/5_create_collection.py)
TOOLS_PIPELINE=cosmos_video_search_milvus
TOOLS_COLLECTION_NAME=PHAIAV Videos Collection
# TOOLS_COLLECTION_ID=

# Transcode proxy (on-the-fly H.265→H.264)
TRANSCODE_PROXY_URL=http://transcode-proxy:9999
TRANSCODE_PROXY_HOST=http://localhost:9999

# ==============================================
# Infrastructure Configuration
# ==============================================

# LocalStack (AWS S3 emulation) Credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# ==============================================
# GPU Configuration
# ==============================================

# Which GPU(s) to use for Milvus (comma-separated device IDs)
MILVUS_CUDA_VISIBLE_DEVICES=0

# Number of GPUs for Cosmos Embed NIM
COSMOS_EMBED_GPUS=1

# NOTE: If you have multiple GPUs, you MUST edit docker-compose.build.yml
# and add /dev/nvidia1..N to the cosmos-embed devices section.
# See the comment in docker-compose.build.yml for details.
# This is a workaround for a CUVID bug where it scans /dev/nvidia* sequentially
# and fails with cudaErrorNoDevice if the sequence is broken.

# ==============================================
# Container Images
# ==============================================

# Cosmos Embed NIM Image
COSMOS_EMBED_IMAGE=nvcr.io/nim/nvidia/cosmos-embed1:1.0.0

# Visual Search Image (name:tag format)
VISUAL_SEARCH_IMAGE=visual-search
# IMAGE_TAG=latest

# Milvus Image
# MILVUS_IMAGE=milvusdb/milvus:v2.4.4-gpu

# LocalStack Image
# LOCALSTACK_IMAGE=localstack/localstack:4.7

# etcd Image
# ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5

# Transcode Proxy Image
# TRANSCODE_PROXY_IMAGE=transcode-proxy:latest

# Cosmos VDS Web UI Image
COSMOS_VDS_WEB_UI_IMAGE=nvcr.io/nvidia/blueprint/cosmos-cds-ui:1.0.0

# bash Image
Bash_IMAGE=bash:latest

# ==============================================
# NIM Configuration
# ==============================================

# Triton verbose logging (0=off, 1=on)
NIM_TRITON_LOG_VERBOSE=0

# NIM log level (DEFAULT, INFO, WARNING, ERROR)
NIM_LOG_LEVEL=DEFAULT

# ==============================================
# Visual Search Service Configuration
# ==============================================

# Gunicorn server configuration
GUNICORN_PORT=8888
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=600

# Maximum documents per upload batch
MAX_DOCS_PER_UPLOAD=3200

# Milvus connection
MILVUS_DOCUMENT_STORE_URI=http://milvus:19530
MILVUS_DB=""

# Cosmos Embed NIM endpoint
COSMOS_EMBED_NIM_URI=http://cosmos-embed:8000

# Allowed search pipelines (comma-separated)
ALLOWED_PIPELINES=cosmos_video_search_milvus

# Logging level (DEBUG, INFO, WARNING, ERROR)
VISUAL_SEARCH_LOG_LEVEL=DEBUG

# ==============================================
# Web UI Configuration
# ==============================================

# API endpoint URL for the web UI
CDS_API_URL=http://localhost:8888/v1

# CDN URL for serving media assets
CDS_CDN_URL=http://localhost:4566/cosmos-test-bucket

# Web UI base URL
CDS_UI_URL=http://localhost:8080/
